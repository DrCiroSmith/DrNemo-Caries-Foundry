#!/usr/bin/env python3
import requests
import os
import json
import shutil
from pathlib import Path
import csv
from datetime import datetime
import time
from dotenv import load_dotenv
from concurrent.futures import ThreadPoolExecutor
import threading

# Load environment variables
load_dotenv()

API_URL = "https://health.api.nvidia.com/v1/biology/openfold/openfold3/predict"
# Support multiple keys for high-throughput pipeline
RAW_KEYS = os.environ.get("NGC_API_KEYS", os.environ.get("NGC_API_KEY", ""))
API_KEYS = [k.strip() for k in RAW_KEYS.split(",") if k.strip()]
CURRENT_KEY_INDEX = 0

BASE_DIR = Path.home() / "drnemo_research"
PENDING_DIR = BASE_DIR / "jobs" / "pending"
COMPLETED_DIR = BASE_DIR / "jobs" / "completed"
FAILED_DIR = BASE_DIR / "jobs" / "failed"
RESULTS_DIR = BASE_DIR / "results"
SCORES_FILE = RESULTS_DIR / "master_scores.csv"
SCORES_LOCK = threading.Lock()

def get_next_key():
    global CURRENT_KEY_INDEX
    if not API_KEYS:
        return None
    key = API_KEYS[CURRENT_KEY_INDEX]
    CURRENT_KEY_INDEX = (CURRENT_KEY_INDEX + 1) % len(API_KEYS)
    return key

def init_env():
    for d in [PENDING_DIR, COMPLETED_DIR, FAILED_DIR, RESULTS_DIR]:
        d.mkdir(parents=True, exist_ok=True)
        
    if not SCORES_FILE.exists():
        with open(SCORES_FILE, 'w', newline='') as f:
            writer = csv.writer(f)
            writer.writerow(["Timestamp", "Job_ID", "Project", "Peptide_Sequence", "pLDDT", "iPTM", "Composite_Score", "Confidence", "Status", "PDB_File", "Error_Msg"])

def log_result(job_id, status, project="", peptide="", plddt="", iptm="", composite="", conf="", pdb_file="", error=""):
    with SCORES_LOCK:
        with open(SCORES_FILE, 'a', newline='') as f:
            writer = csv.writer(f)
            timestamp = datetime.now().isoformat()
            writer.writerow([timestamp, job_id, project, peptide, plddt, iptm, composite, conf, status, pdb_file, error])

def process_job(job_file):
    max_retries = len(API_KEYS)
    attempts = 0
    
    while attempts < max_retries:
        current_key = get_next_key()
        if not current_key:
            print("❌ Error: No NGC_API_KEYS found in .env")
            return False

        try:
            with open(job_file, 'r') as f:
                job_data = json.load(f)
                
            request_id = job_data.get("request_id", job_data.get("job_id", job_file.stem))
            project_id = job_data.get("project", "")
            peptide_seq = job_data.get("peptide_sequence", "")
            
            molecules = job_data.get("molecules", [])
            if not molecules:
                p_seq = job_data.get("protein_sequence")
                if p_seq:
                    molecules.append({
                        "type": "protein", 
                        "sequence": p_seq,
                        "msa": {"dummy_db": {"a3m": {"alignment": f">seq\n{p_seq}", "format": "a3m"}}}
                    })
                
                pept_seq = job_data.get("peptide_sequence")
                if pept_seq:
                    molecules.append({
                        "type": "protein", 
                        "sequence": pept_seq,
                        "msa": {"dummy_db": {"a3m": {"alignment": f">seq\n{pept_seq}", "format": "a3m"}}}
                    })
                    
            if not molecules:
                raise ValueError("No protein or peptide sequences found in job file.")
            
            headers = {
                "Authorization": f"Bearer {current_key}",
                "Accept": "application/json"
            }
            
            data = {
                "inputs": [{
                    "input_id": request_id,
                    "molecules": molecules,
                    "output_format": "pdb"
                }]
            }
            
            # --- COMPLIANCE LOGGING ---
            try:
                from compliance_logger import log_openfold_execution
                log_openfold_execution(request_id, data["inputs"][0])
            except ImportError:
                pass
            # --------------------------
            
            key_num = ((CURRENT_KEY_INDEX - 1) % len(API_KEYS)) + 1
            print(f"🚀 Sending request [{request_id}] to NVIDIA Cloud (Key #{key_num})...")
            r = requests.post(url=API_URL, json=data, headers=headers)
            
            if r.status_code == 429:
                print(f"⚠️ Key #{key_num} rate limited (429).")
                attempts += 1
                time.sleep(1)
                continue
                
            if not r.ok:
                error_msg = f"API Error {r.status_code}: {r.text[:200]}"
                print(f"❌ {error_msg}")
                log_result(request_id, "FAILED_API", project=project_id, peptide=peptide_seq, error=error_msg)
                return False
                
            result = r.json()
            struct_data = result['outputs'][0]['structures_with_scores'][0]
            pdb_content = struct_data['structure']
            
            plddt = struct_data.get('complex_plddt_score', 0)
            iptm = struct_data.get('iptm_score', 0)
            conf = struct_data.get('confidence_score', 0)
            
            pdb_filename = RESULTS_DIR / f"{request_id}.pdb"
            with open(pdb_filename, "w", encoding="utf-8") as f:
                f.write(pdb_content)
                
            print(f"✅ SUCCESS: {pdb_filename.name} created! (pLDDT: {plddt:.2f}, iPTM: {iptm:.2f})")
            
            # Calculate Composite Score: (pLDDT / 100) * iPTM
            composite_score = (plddt / 100.0) * iptm
            
            log_result(request_id, "SUCCESS", project=project_id, peptide=peptide_seq,
                       plddt=plddt, iptm=iptm, composite=composite_score, conf=conf, pdb_file=pdb_filename.name)
            return True
            
        except Exception as e:
            print(f"❌ Error processing {job_file.name}: {e}")
            log_result(job_file.stem, "FAILED_EXCEPTION", project=project_id, peptide=peptide_seq, error=str(e))
            return False

    print("🚨 All API keys are currently rate-limited. Shifting job to failed for manual retry later.")
    return False

def worker_task(job_file):
    success = process_job(job_file)
    if success:
        shutil.move(str(job_file), str(COMPLETED_DIR / job_file.name))
    else:
        shutil.move(str(job_file), str(FAILED_DIR / job_file.name))
    # Each worker waits 1.6s to keep the total throughput safe across 4 keys
    # 60s / 40req = 1.5s. 1.6s is safe.
    time.sleep(1.6)

def run_pipeline():
    init_env()
    job_files = sorted(list(PENDING_DIR.glob("*.json")))
    
    if not job_files:
        print("📭 No pending jobs found.")
        return
        
    num_keys = len(API_KEYS)
    if num_keys == 0:
        print("❌ No API keys available.")
        return

    print(f"📥 Found {len(job_files)} jobs. Processing with {num_keys} parallel workers...")
    
    with ThreadPoolExecutor(max_workers=num_keys) as executor:
        executor.map(worker_task, job_files)
        
if __name__ == "__main__":
    run_pipeline()
