# Dr. Nemo Caries Foundry - Git Ignore
# Exclude transitory research data and large binaries

# Research Outputs (root runtime directories)
/results/
/jobs/
*.csv

# Allow bundled demo dataset explicitly
!demo_data/
!demo_data/**
demo_data/results/screenshots/
!targets.json

# Python
__pycache__/
*.pyc
venv/
.env

# OS
.DS_Store
Thumbs.db
3AIC.pdb

# Allow authentic contender ledger
!data/contenders_ledger.csv

# Runtime logs
*.log
data/logs/

# Continuous hunter transitory contenders
data/poses/contender_g0[2-9]*
data/poses/contender_g[1-9][0-9]*

# LaTeX intermediate build files
*.aux
*.bbl
*.blg
*.out

# Agent configuration, prompts, and temporary files
CLAUDE.md
AGENTS.md
GEMINI.md
copilot-instructions.md
linkedin_post_drnemo.md
PLAN.md
scripts/*_temp.py
scripts/test_*.py
scripts/check_*.py
# Exception: this one is a permanent, CI-enforced check, not a one-off.
!scripts/check_result_provenance.py
scripts/audit_all_poses.py
scripts/list_rank1.py
scripts/compare_leads.py
scripts/calc_nulls.py
