# Dr. Nemo Caries Vaccine Foundry - Git Ignore
# Exclude transitory research data and large binaries

# Research Outputs (root runtime directories)
/results/
/jobs/
*.csv

# Allow bundled demo dataset explicitly
!demo_data/
!demo_data/**
!targets.json
!expansion_stats.json

# Python
__pycache__/
*.pyc
venv/
.env

# OS
.DS_Store
Thumbs.db
3AIC.pdb

# Allow authentic contender ledger
!data/contenders_ledger.csv

# Runtime logs
*.log
data/logs/

# Continuous hunter transitory contenders
data/poses/contender_g0[2-9]*
data/poses/contender_g[1-9][0-9]*

# LaTeX intermediate build files
*.aux
*.bbl
*.blg
*.out
